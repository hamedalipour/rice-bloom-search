# نمونهٔ .htaccess برای اپ Node در cPanel (CloudLinux + LiteSpeed)
#
# این فایل را cPanel خودکار در ریشهٔ اپ (apps/atre-api/panel) می‌سازد؛
# بعد از ساخت اپ، فقط بخش «Security» را به انتهای آن اضافه کنید.
# اگر اپ را Destroy/Create کردید، این بلوک را دوباره اضافه کنید.
#
# نکتهٔ مهم (تجربهٔ واقعی روی این هاست):
#   - <FilesMatch ...> Require all denied  روی این استک نادیده گرفته می‌شود.
#   - فقط mod_rewrite با پرچم [F,L] واقعاً فایل‌ها را می‌بندد.
#   - هرگز از [R=404,L] استفاده نکنید؛ Passenger را از کار می‌اندازد
#     و همهٔ /api/* ها 403 می‌شوند.

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/USER/apps/atre-api/panel"
PassengerBaseURI "/"
PassengerNodejs "/home/USER/nodevenv/apps/atre-api/panel/22/bin/node"
PassengerAppType node
PassengerStartupFile server.cjs
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

# ------------------------------------------------------------------
# Security: source, config, logs and order data must never be served
# as static files. API traffic is handled by Express, not the FS.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)(server\.cjs|package\.json|package-lock\.json|stderr\.log)$ - [F,L]
  RewriteRule (^|/)\.env - [F,L]
  RewriteRule ^(data|node_modules|tmp|public)(/|$) - [F,L]
</IfModule>
