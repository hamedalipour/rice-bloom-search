# ---------------------------------------------------------------
# atre-shalizar.ir — تنظیمات Apache/LiteSpeed روی هاست ایرانی
# این فایل در public/ است تا Vite آن را داخل dist/ کپی کند.
# ---------------------------------------------------------------

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ۱) انتقال اجباری به HTTPS (با احترام به پروکسی)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ۲) یکسان‌سازی دامنه: www → بدون www (canonical سایت)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# صفحه ۴۰۴ اختصاصی (به‌جای index.html تا soft-404 ایجاد نشود)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS بعد از اطمینان از فعال بودن SSL روی دامنه و api فعال شود:
  # Header always set Strict-Transport-Security "max-age=31536000"

  # فایل‌های هش‌دار Vite: کش یک‌ساله و تغییرناپذیر
  <FilesMatch "\.(js|css|woff2?|ttf|eot|jpg|jpeg|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML همیشه تازه بررسی شود تا بعد از دیپلوی، نسخه قدیمی سرو نشود
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# فایل‌های حساس اگر اشتباهی در وب‌روت قرار گرفتند، سرو نشوند
<FilesMatch "^(\.env.*|package(-lock)?\.json|.*\.map)$">
  Require all denied
</FilesMatch>
