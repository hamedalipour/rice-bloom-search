# ---------------------------------------------------------------
# Supabase (موجود قبلاً)
# ---------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ---------------------------------------------------------------
# درگاه پرداخت — زرین‌پال (ZarinPal)
# ---------------------------------------------------------------
# کد Merchant از پنل زرین‌پال دریافت می‌شود
ZARINPAL_MERCHANT_ID="your_zarinpal_merchant_id"

# حالت آزمایشی: "true" برای sandbox، "false" برای production
ZARINPAL_SANDBOX="true"

# آدرس پایه سایت frontend (در توسعه معمولاً 5173)
FRONTEND_BASE_URL="http://localhost:5173"

# آدرس پایه سرور backend/پنل مدیریت (برای فراخوانی از سمت کلاینت)
VITE_PANEL_API_BASE="http://127.0.0.1:3001"

# ---------------------------------------------------------------
# نحوه فعال‌سازی:
# 1. این فایل را کپی کنید و نام آن را .env بگذارید
#    cp .env.example .env
# 2. مقادیر placeholder را با مقادیر واقعی خود پر کنید
# 3. سرور پنل را اجرا کنید:  npm run panel   (پورت 3001)
# 4. سایت را اجرا کنید:     npm run dev      (پورت 5173)
# 5. در سایت به صفحه /checkout بروید، روش "پرداخت آنلاین" را انتخاب کنید.
# ---------------------------------------------------------------
