# ---------------------------------------------------------------
# Supabase (اختیاری — اگر جایی استفاده می‌شود)
# ---------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ===============================================================
# ۱) متغیرهای سرور (پنل / API) — فقط روی سرور یا در .env محلی
# ===============================================================
# کد ۳۶ کاراکتری پذیرنده از پنل زرین‌پال
ZARINPAL_MERCHANT_ID="your_zarinpal_merchant_id"

# true = سندباکس، false = پرداخت واقعی
ZARINPAL_SANDBOX="true"

# آدرس سایت اصلی؛ کاربر بعد از پرداخت به این دامنه برگردانده می‌شود
FRONTEND_BASE_URL="http://localhost:5173"

# آدرس عمومی همین API برای ساخت callback_url (در production الزامی)
# مثال: https://api.atre-shalizar.ir
API_PUBLIC_URL="http://localhost:3001"

# ورود پنل مدیریت (Basic Auth). روی سرور عمومی، نبودِ ADMIN_PASS مانع اجرا می‌شود.
ADMIN_USER="admin"
ADMIN_PASS="یک-رمز-قوی-بگذارید"

# اختیاری: فقط این IPها اجازه ورود به پنل داشته باشند (با کاما جدا شود)
ADMIN_ALLOW_IPS=""

# دامنه‌های مجاز برای CORS (با کاما جدا شود)
CORS_ORIGINS="https://atre-shalizar.ir,https://www.atre-shalizar.ir,http://localhost:5173"

# انتشار مستقیم از پنل به گیت‌هاب (git commit/push). روی هاست اشتراکی
# فقط اگر مطمئن هستید و توکن گیت را تنظیم کرده‌اید true کنید.
ALLOW_GIT_PUBLISH="false"

# ===============================================================
# ۲) متغیرهای build فرانت‌اند (Vite) — در GitHub Actions تنظیم شوند
# ===============================================================
# آدرس API پرداخت. در production: https://api.atre-shalizar.ir
# اگر خالی بماند، درخواست‌ها به همان دامنه سایت می‌روند و شکست می‌خورند.
VITE_PANEL_API_BASE=""

# false = درگاه واقعی (برای باندل production)
VITE_ZARINPAL_SANDBOX="false"

# ---------------------------------------------------------------
# اجرای محلی:
#   1) این فایل را به .env کپی کنید.
#   2) ZARINPAL_SANDBOX=true و FRONTEND_BASE_URL=http://localhost:5173 بگذارید.
#   3) npm run panel  (پورت 3001)
#   4) npm run dev    (پورت 5173؛ /api به 3001 پروکسی می‌شود)
# ---------------------------------------------------------------
